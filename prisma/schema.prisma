generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  wallet         String   @unique
  name           String?
  avatar         String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  preferredChain String?
  preferredToken String?
  isCreator      Boolean  @default(false)
  isDonor        Boolean  @default(false)
  shiftsReceived Shift[]  @relation("CreatorShifts")
  shiftsSent     Shift[]  @relation("UserShifts")
}

model Shift {
  id             String    @id @default(cuid())
  shiftId        String    @unique
  creatorId      String
  status         String    @default("waiting")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  updatedAt      DateTime  @updatedAt
  userId         String
  amount         Float
  network        String
  token          String
  txHash         String?
  cancellableAt  DateTime
  cancelledAt    DateTime?
  completedAt    DateTime?
  expiredAt      DateTime?
  creatorAddress String
  donorAddress   String
  settleAddress  String
  creator        User      @relation("CreatorShifts", fields: [creatorId], references: [id])
  donor          User      @relation("UserShifts", fields: [userId], references: [id])
}
